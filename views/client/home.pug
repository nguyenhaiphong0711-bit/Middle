          .col-xXl-6.col-xl-5.col-lg-5.d-none.d-lg-block
            form(action="#")
              select(class="select_2")
                option All Categories
                option Fashion
                option Elentronics
                option Fashion & Beauty
                option Jewelry
                option Grocery
              .input
                input(
                  placeholder="Search your product..." 
                  type="text"
                  )
                button(type="submit")
                  i.far.fa-search
          .col-xXl-4.col-xl-5.col-lg-5.d-none.d-lg-flex
            .d-flex.flex-wrap(class="header_support_user")
              div(class="header_support")
                span.icon
                  i.far.fa-phone-alt
                h3
                  | Hotline:
                  a(href="callto:1234567890")
                    span +(402) 763 282 46
            .d-flex.flex-wrap.align-items-center.justify-content-end(class="topbar_right")
              select.language(class="select_js")
                option English
                option Arabic
                option Hindi
                option Chinese
              select(class="select_js")
                option $USD
                option €EUR
                option ¥JPY
                option £GBP
                option ₹INR
